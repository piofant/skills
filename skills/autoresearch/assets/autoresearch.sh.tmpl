#!/usr/bin/env bash
# Autoresearch runner template (Mode A).
# Goal: run the evaluation against the CURRENT state of the in-scope files and
# print one or more `METRIC <name>=<value>` lines on stdout. The agent parses
# `METRIC primary=...` to decide keep/discard.
set -euo pipefail

# --- 1. run your eval / measurement here -------------------------------------
# Examples:
#   OUT=$(python3 -m yourpkg.evals.run --out /tmp/eval 2>&1 | tail -40)
#   OUT=$(node bench.js 2>&1)
#   OUT=$(curl -s -X POST https://detector.example/score -F file=@thesis.txt)
OUT=$(echo "replace-me")

# --- 2. parse the number(s) out of OUT --------------------------------------
PRIMARY=$(echo "$OUT" | grep -oE "score: [0-9.]+" | grep -oE "[0-9.]+" | head -1)

# --- 3. emit METRIC lines (this is the contract the loop reads) --------------
echo "METRIC primary=${PRIMARY:-0}"
# echo "METRIC aggregate=${AGG:-0}"
